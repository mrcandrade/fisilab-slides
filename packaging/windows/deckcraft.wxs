<?xml version="1.0" encoding="utf-8"?>
<!--
  Slides MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build deckcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files\Suite FisiLab\Slides (the suite's Inno Setup layout),
  a Start Menu shortcut, `.deckcraft` owned by Slides, and Slides offered under "Open with" for
  .pptx/.potx/.ppsx (without taking over the user's default app for them).

  Suíte FisiLab: Slides has its own UpgradeCode and component GUIDs (never DeckCraft's, so it
  neither upgrades nor removes an upstream DeckCraft install); never change them. The suite's
  official installer is an Inno Setup one built by the suite's orchestrator; this MSI is kept
  working for reference.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Slides"
      Manufacturer="FisiLab — LARFIC/UFRGS"
      Version="$(var.Version)"
      UpgradeCode="2B3056DB-EAB4-4868-AAF4-AA3D980D3835"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Slides — Apresentações (Suíte FisiLab)" Manufacturer="FisiLab — LARFIC/UFRGS" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais nova do Slides já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SlidesIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SlidesIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mrcandrade/larfic/tree/main/suite-fisilab" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mrcandrade/fisilab-slides/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mrcandrade/fisilab-slides/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="FISILABFOLDER" Name="Suite FisiLab">
        <Directory Id="INSTALLFOLDER" Name="Slides" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Slides" Level="1">
      <ComponentGroupRef Id="SlidesFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="SlidesFiles" Directory="INSTALLFOLDER">
      <Component Id="SlidesApp" Guid="3CB23281-E85F-4159-819F-DE6B5C60B292">
        <File Id="SlidesExe" Source="$(var.BinDir)\fisilab-slides.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Slides"
              Description="Slides — Apresentações (Suíte FisiLab)" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SlidesIcon.ico" IconIndex="0" />
        </File>

        <!-- .deckcraft: the DeckCraft/FisiLab Slides format (extension unchanged for compatibility). -->
        <ProgId Id="FisiLab.Slides.Presentation" Description="Apresentação do FisiLab Slides" Icon="SlidesExe" IconIndex="0">
          <Extension Id="deckcraft" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Abrir" TargetFile="SlidesExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-slides.exe" Name="FriendlyAppName" Value="Slides" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-slides.exe\shell\open\command" Value="&quot;[#SlidesExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-slides.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-slides.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-slides.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-slides.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="FisiLab.Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="FisiLab.Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="FisiLab.Slides.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fisilab-slides.exe" Value="[#SlidesExe]" Type="string" />
      </Component>

      <Component Id="SlidesCli">
        <File Id="SlidesCliExe" Source="$(var.BinDir)\fisilab-slides-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
