<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.slides</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Slides</name>
  <summary>Apresentações — Suíte FisiLab (alternativa livre)</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      O Slides cria e apresenta apresentações de slides: temas, layouts, formas, imagens,
      tabelas, gráficos, transições e animações. Abre e salva arquivos do PowerPoint (.pptx)
      e apresenta em tela cheia, com modo do apresentador.
    </p>
    <p>
      Cada ação também é um comando que a linha de comando e agentes de IA (via MCP) podem usar.
    </p>
    <p>
      Faz parte da Suíte FisiLab, do FisiLab — LARFIC (UFRGS). Baseado no DeckCraft, do
      ArtCraft Team e contribuidores (MIT ou Apache 2.0).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.slides.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.slides</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-slides/issues</url>
  <url type="help">https://github.com/mrcandrade/fisilab-slides</url>
  <url type="contact">https://github.com/mrcandrade/fisilab-slides/issues</url>
  <categories>
    <category>Office</category>
    <category>Presentation</category>
  </categories>
  <keywords>
    <keyword>presentation</keyword>
    <keyword>slides</keyword>
    <keyword>slide show</keyword>
    <keyword>pptx</keyword>
    <keyword>apresentação</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#ffc9a8</color>
    <color type="primary" scheme_preference="dark">#b8471f</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>fisilab-slides</binary>
    <mediatype>application/x-deckcraft</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
